{
  "name": "@sessionry/plugin-default-view-chat",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/main.js",
  "exports": {
    ".": "./src/index.ts",
    "./renderer": "./src/renderer.tsx"
  },
  "scripts": {
    "build": "pnpm build:main && pnpm build:renderer",
    "build:main": "vite build --config vite.main.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@sessionry/plugin-api": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
