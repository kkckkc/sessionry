{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@sessionry/plugin-default-view-terminal/renderer": ["../../plugins/plugin-default-view-terminal/src/renderer.tsx"],
      "@sessionry/plugin-default-view-terminal": ["../../plugins/plugin-default-view-terminal/src/index.ts"],
      "@sessionry/plugin-default-view-workspace/renderer": ["../../plugins/plugin-default-view-workspace/src/renderer.tsx"],
      "@sessionry/plugin-default-view-workspace": ["../../plugins/plugin-default-view-workspace/src/index.ts"],
      "@app-shared/*": ["src/shared/*"],
      "@app-renderer/*": ["src/renderer/src/*"],
      "@sessionry/plugin-api": ["../plugin-api/src/index.ts"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "vite.host.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "vitest.config.ts"
  ]
}
