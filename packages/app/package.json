{
  "name": "@sessionry/app",
  "version": "0.1.0",
  "private": true,
  "description": "Extensible Electron terminal bootstrap built with TypeScript, React, Base UI, and xterm.js.",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "pnpm build:host && electron-vite dev",
    "build": "pnpm build:host && electron-vite build",
    "build:host": "vite build -c vite.host.config.ts",
    "preview": "electron-vite preview",
    "postinstall": "node scripts/fix-node-pty.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run -c vitest.config.ts",
    "package": "pnpm build && electron-builder build --publish never"
  },
  "build": {
    "appId": "com.sessionry.app",
    "productName": "Sessionry",
    "mac": {
      "target": "dmg",
      "icon": "icons/sessionry-1024x1024-padded.png"
    },
    "win": {
      "target": "nsis",
      "icon": "icons/sessionry-icon-512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icons/sessionry-icon-512.png"
    },
    "files": [
      "out/**/*"
    ]
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@sessionry/components": "workspace:*",
    "@sessionry/design-tokens": "workspace:*",
    "@sessionry/plugin-api": "workspace:*",
    "cmdk": "^1.0.0",
    "@sessionry/plugin-debug-view-pane-hierarchy": "workspace:*",
    "@sessionry/plugin-default-vcs-git": "workspace:*",
    "@sessionry/plugin-default-view-code": "workspace:*",
    "@sessionry/plugin-default-view-files": "workspace:*",
    "@sessionry/plugin-default-view-left-sidebar": "workspace:*",
    "@sessionry/plugin-default-view-notes": "workspace:*",
    "@sessionry/plugin-default-view-sidebar-tabbar": "workspace:*",
    "@sessionry/plugin-default-view-terminal": "workspace:*",
    "@sessionry/plugin-default-view-vcs": "workspace:*",
    "@sessionry/plugin-default-view-workspace": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "latest",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-icons": "^5.6.0",
    "semver": "^7.7.4",
    "tar": "^7.5.13",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/tar": "^7.0.87",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "latest",
    "electron-builder": "^26.8.1",
    "electron-vite": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vite": "^7.1.12",
    "vitest": "latest"
  }
}
